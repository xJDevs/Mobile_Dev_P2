# Plantilla de variables de entorno. La copia local va en .env (no se versiona).
# Las variables EXPO_PUBLIC_* quedan embebidas en el bundle: solo la demo key gratuita de CoinGecko.

# Opcional. Sin valor, la app usa la API pública de CoinGecko (con límite de peticiones).
# Demo key: https://www.coingecko.com/en/api
EXPO_PUBLIC_COINGECKO_API_KEY=
